# Unity auto-generated cache and build intermediates
# large and reproducible, no need to commit
/Library/
/Temp/
/obj/
/Build/
/Builds/

# Local logs and per-user settings
# machine/personal specific, committing causes team conflicts
/Logs/
/UserSettings/

# IDE project files and memory snapshots
# auto-generated by tools, should not be version-controlled
*.csproj
*.sln
*.user
/MemoryCaptures/